# MCPVault HTTP server (loopback only; exposed via mcpvault-tunnel.service).
# Master key: root-owned /etc/mcp-vault/master.key handed to the service as a
# systemd credential, so the mcpvault user can never read the file itself.
[Unit]
Description=MCPVault (password vault MCP server, loopback HTTP)
After=network.target
Documentation=https://github.com/smSamani/MCPVault

[Service]
Type=simple
User=mcpvault
Group=mcpvault
ExecStart=/usr/bin/node /opt/mcp-vault/dist/src/cli.js serve-http
Environment=MCP_VAULT_HOME=/var/lib/mcp-vault
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=96
LoadCredential=mcp-vault-master-key:/etc/mcp-vault/master.key
StateDirectory=mcp-vault
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# Resource limits
MemoryMax=150M
TasksMax=64
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mcp-vault
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# (MemoryDenyWriteExecute is NOT set: V8's JIT needs writable+executable pages.)

[Install]
WantedBy=multi-user.target
